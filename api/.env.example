# Copy to .env and provide real values at runtime. Never commit .env.

# API and database
DATABASE_URL=postgres://user:password@db:5432/vanitydb
PORT=3000

# Separate credentials for untrusted workers and the platform/key-delivery plane.
# Use independently generated random values of at least 32 characters.
WORKER_API_KEY=
PLATFORM_API_KEY=

# AWS KMS envelope encryption
AWS_REGION=us-east-1
KMS_KEY_ID=

# Prefer an instance/task role or another AWS default credential-provider-chain
# source in deployed environments. Static credentials are shown only as an
# optional local-development mechanism.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
