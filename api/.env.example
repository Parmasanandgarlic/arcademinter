# This is an example file. Copy to .env and fill in your actual values.
# The .env file is ignored by Git and should never be committed.

# API & Database
DATABASE_URL=postgres://user:password@db:5432/vanitydb
WORKER_API_KEY= # GENERATE A STRONG RANDOM STRING HERE

# AWS Configuration
AWS_REGION= # e.g., us-east-1
KMS_KEY_ID= # The Key ID from your AWS KMS setup
AWS_ACCESS_KEY_ID= # Your AWS Access Key
AWS_SECRET_ACCESS_KEY= # Your AWS Secret Key
